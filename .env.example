# PFS 本地配置示例。不要把真实密钥、令牌或数据库连接串提交到仓库。
# 复制为 .env.local 后按部署环境填写；当前应用不会自动加载本文件。

# 产品表面（可选）
PFS_PRODUCT_NAME=PFS 数据分析 Agent
PFS_PRODUCT_TAGLINE=可追踪、可核验的报表数据分析工作台
PFS_PRODUCT_VERSION=0.1.0-dev
PFS_REPOSITORY_URL=https://github.com/Lukanytsu7551/PFS-data-analysis-agent

# 发布检查默认关闭；只有配置并审核发布通道后才打开。
PFS_UPDATE_CHECK_ENABLED=0
PFS_AUTO_INSTALL_DEPENDENCIES=0
PFS_SKIP_DEPENDENCY_CHECK=0

# 已保留但默认休眠的扩展能力；需要时再显式打开。
PFS_ENABLE_HOOKS=0
PFS_ENABLE_FEISHU_BOT=0
PFS_ENABLE_CLOUD_LOGIN=0
PFS_ENABLE_DURABLE_QUEUE=0

# Cross-process recovery uses SQLite files on one shared writable volume.
# ``api`` is the pure HTTP producer role; run scripts/durable_queue_worker.py
# separately with ``worker`` and the same paths/volume. ``embedded`` starts a
# local sidecar in the API process. This is not a multi-host queue adapter.
PFS_DURABLE_QUEUE_ROLE=api
PFS_DURABLE_QUEUE_DB_PATH=
PFS_QUEUE_WORKER_ID=
PFS_QUEUE_POLL_SECONDS=0.2
PFS_QUEUE_LEASE_SECONDS=30
PFS_JOBS_DB_PATH=
PFS_CHAT_STATE_DB_PATH=

# 可选的自有向量服务；留空时使用本地模型或 hash fallback。
PFS_CLOUD_EMBED_URL=
PFS_CLOUD_EMBED_TOKEN=
PFS_CLOUD_EMBED_MODEL=bge-large-zh

# 本地服务入口（PORT / AGENT_PORT 仍兼容现有启动脚本）。
PFS_HOST=127.0.0.1
PFS_PORT=5001
PFS_DATA_DIR=
PFS_RESOURCE_DIR=
