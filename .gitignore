# ============================================================
#  PFS 数据分析 Agent — .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.python-version

# ---- Build / dist ----
node_modules/
build/
dist/
frontend/dist/
# The Flask app serves Vite output directly from static/dist in source builds.
# Keep generated runtime assets trackable so GitHub users do not load a 404 shell.
static/dist/*
!static/dist/
!static/dist/*.js
!static/dist/*.css
!static/dist/chunks/
!static/dist/chunks/**
!static/dist/assets/
!static/dist/assets/**
!static/dist/.vite/
!static/dist/.vite/**
*.spec
!packaging/pfs_data_analysis_agent.spec
*.egg-info/
.eggs/

# ---- Runtime / cache ----
.deps_installed
.session_tmps/
outputs/
tmp/
uploads/
*.log
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
auth.db
auth.db-wal
auth.db-shm

# ---- Tests ----
# PFS-owned tests are versioned.  The upstream uppercase Test/ conventions
# are handled separately below until their inventory is migrated.
/tests/
!/tests/
!/tests/**
# Re-ignore generated Python bytecode after re-including PFS-owned tests.
/tests/**/__pycache__/
/tests/**/*.py[cod]

# Keep the tests already tracked by Git for GitHub Actions, but do not add
# newly created local tests to the repository.
Test/*
!Test/test_workflow_contracts.py
!Test/test_workflows.py
!Test/test_workflow_scheduler.py
!Test/test_job_terminal_listeners.py
!Test/test_workflow_runtime.py
!Test/test_workspace_storage_workflow_refs.py
!Test/test_workflow_frontend_panel.py
!Test/test_workflow_sqlite_locking.py
!Test/fixtures/
!Test/fixtures/workflows/
!Test/fixtures/workflows/operating_analysis_v1.json
Test/local_*.py
Test/test_workspace_storage_cleanup.py

# Keep all development tests local.
Test/

# ---- IDE / editor ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
.workbuddy

# ---- OS ----
desktop.ini

# ---- Local secrets / config ----
**/secret_key
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm
.env
.env.local
*.local
LLM/llm_config.json
LLM/mcp_config.json
LLM/embedding_config.json
data/datasource_config.json
.playwright-mcp
docs/*
!docs/14-local-duckdb-concurrency-import-plan.md
!docs/10-ai-team-workflow-optimization-plan.md
!docs/11-ai-team-workflow-wf0-decisions.md
!docs/
!docs/**
test.bat
01-notes-for-development.md


# ---- Large assets that should not be tracked ----
*.psd
!Banner.psd

# ---- Ongoing work / WIP (next-version, not ready to push) ----
MCP/Flowchart
MCP/mindmap
MCP/playwright
MCP/flowchart_server.py
RAILWAY_DEPLOY.md
config/hooks.json
config/hooks-history.json
config/feishu-bot.json
frontend/README.md
package-lock.json
.claude
.agents/
.uploads/
memory/
# Keep local maintenance scripts private, but version the three scripts required by
# `pnpm run build` so release runners can build the chat bundle.
scripts/*
!scripts/build-chat.mjs
!scripts/clean-chat-chunks.mjs
!scripts/verify-chat-bundle.mjs
# Untracked assets
Information/assets/LOGO.png
Information/assets/
!PRODUCT.md

# The original extracted snapshot stays local as a reference and is not part
# of the PFS repository source tree.
Data-Analysis-Agent-main/

# Original installer artwork is not part of the PFS product surface.
installer/assets/Banner.psd

# Legacy eye-mark artwork is not used by the PFS runtime; keep only pfs-mark.
static/Images/icon.png
static/Images/icon-sm.png
static/favicon.ico

# Retired draw.io credentials are preserved as local-only residue until the
# user explicitly authorizes credential cleanup; packaging rejects this tree.
static/drawio/WEB-INF/*_client_secret
static/drawio/WEB-INF/cloud_convert_api_key
static/drawio/WEB-INF/pusher_properties

# Local export inspection workspace; generated artifacts are not source.
_pfs-export-test/
